# Copy to .env.local (or set in Vercel) and fill in real values.

# --- Required ---------------------------------------------------------------
# Runtime connection (Supabase pooler) and direct connection used by Prisma migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/internship?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/internship?schema=public"

# Public URL of the app, used for OAuth redirects and links sent by email.
APP_BASE_URL="http://localhost:3000"

# Random secret (>= 32 chars) used to sign OAuth state and encrypt Gmail tokens.
# Generate one with: openssl rand -base64 48
# Changing it invalidates stored Gmail tokens: users will have to reconnect Gmail.
APP_SECRET=""

# --- Gmail integration (optional) -------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Defaults to ${APP_BASE_URL}/api/email/google/callback when empty.
GOOGLE_REDIRECT_URI=""

# --- Gemini (optional, drafts and enrichment fall back to deterministic output) ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Email forwarding fallback (optional) -----------------------------------
EMAIL_FORWARDING_DOMAIN=""

# --- Local scripts only -----------------------------------------------------
NOTION_TOKEN_CODEX=""
NOTION_PERSONAS_PARENT_PAGE_ID=""
PERSONA_EVAL_BASE_URL="http://localhost:3000"

# --- Search sources ----------------------------------------------------------
# Direct LinkedIn guest jobs endpoint. Off by default: it is not a public API and
# LinkedIn's terms forbid automated access. LinkedIn offers still appear via web search.
ENABLE_LINKEDIN_DIRECT_SOURCE="false"
