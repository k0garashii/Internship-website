# Copy to .env.local (or set in Vercel) and fill in real values.

# --- Required ---------------------------------------------------------------
# Runtime connection (Supabase pooler) and direct connection used by Prisma migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/internship?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/internship?schema=public"

# Public URL of the app, used for OAuth redirects and links sent by email.
APP_BASE_URL="http://localhost:3000"

# Random secret (>= 32 chars) used to sign OAuth state and encrypt Gmail tokens.
# Generate one with: openssl rand -base64 48
# Changing it invalidates stored Gmail tokens: users will have to reconnect Gmail.
APP_SECRET=""

# --- Gmail integration (optional) -------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Defaults to ${APP_BASE_URL}/api/email/google/callback when empty.
GOOGLE_REDIRECT_URI=""

# --- Gemini (optional, drafts and enrichment fall back to deterministic output) ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Email forwarding fallback (optional) -----------------------------------
EMAIL_FORWARDING_DOMAIN=""

# --- Local scripts only -----------------------------------------------------
NOTION_TOKEN_CODEX=""
NOTION_PERSONAS_PARENT_PAGE_ID=""
PERSONA_EVAL_BASE_URL="http://localhost:3000"

# --- Search sources ----------------------------------------------------------
# Comma-separated emails of developer accounts. They get the direct LinkedIn
# source (not a public API, LinkedIn's terms forbid automated access).
DEVELOPER_EMAILS=""
# Turns the direct LinkedIn source on for every account. Leave off.
ENABLE_LINKEDIN_DIRECT_SOURCE="false"

# --- Scheduled maintenance (daily search, offer checks, digests) ------------
# Random secret checked on /api/cron/maintenance. Vercel Cron sends it
# automatically once set. Generate with: openssl rand -hex 32
CRON_SECRET=""
# Optional app mailer for digests. Without it, digests are sent from the user's
# own Gmail to themselves (requires the Gmail send permission).
RESEND_API_KEY=""
EMAIL_FROM=""

# --- Pro subscription (Stripe) -------------------------------------------------
# Secret key (sk_test_... first, sk_live_... in production), the recurring price
# of the Pro plan and the signing secret of the webhook endpoint
# <APP_BASE_URL>/api/billing/stripe/webhook. Without them the Pro plan is hidden.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_WEBHOOK_SECRET=""

# --- Official job sources (Pro plan) ------------------------------------------
# France Travail "Offres d'emploi v2" application credentials (francetravail.io).
FRANCE_TRAVAIL_CLIENT_ID=""
FRANCE_TRAVAIL_CLIENT_SECRET=""
